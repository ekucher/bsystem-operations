# Скопіюйте як .env у корені репозиторію для docker-compose.yml (не
# комітиться). Це окремий файл від api/.env.example — той для
# `npm run dev --workspace=api` (локальний запуск без Docker), цей —
# для змінних, які docker-compose.yml підставляє в ${VAR} у контейнер api.

# ОБОВ'ЯЗКОВО: без дефолту в docker-compose.yml навмисно — `docker compose
# up` відмовиться стартувати (`variable is not set`), поки це не задано.
# Без цього enroll-маршрути fail-closed (503), а не приймають запити без
# автентифікації — слабкий дефолт тут був би реальною production-дірою.
OPERATIONS_BOOTSTRAP_SECRET=change-me

# COOKIE_SECURE навмисно НЕ підставляється тут — базовий docker-compose.yml
# не має compose-рівневого override для нього, тож лишається дефолт
# api/src/config.ts (true, Secure-cookie), як і має бути в production.
# Для локальної розробки по http без TLS скопіюйте
# docker-compose.override.yml.example -> docker-compose.override.yml
# (лишається local-only, у .gitignore) — там COOKIE_SECURE=false.

# Etap 4: offline-детекція -> наявний Discord alerts-канал. Порожньо =
# алертинг вимкнено (fail-safe no-op, не crash).
DISCORD_ALERTS_WEBHOOK_URL=
OFFLINE_CHECK_INTERVAL_MINUTES=5

# Git-ревізія образу, яка потрапляє в build arg api/Dockerfile і
# повертається в GET /health (`revision`) — суто інформаційне, для
# "яка саме збірка зараз працює". Незадано = "unknown", не помилка.
GIT_SHA=unknown
