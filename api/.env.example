# Скопіюйте як .env для локального запуску (не комітиться).

PORT=8080
DB_PATH=./data/operations.sqlite3

# БЕЗ дефолту навмисно: без нього enroll-маршрути fail-closed (503), а
# не приймають запити без автентифікації.
OPERATIONS_BOOTSTRAP_SECRET=change-me

EVENT_RETENTION_DAYS=90
HEARTBEAT_MISSED_THRESHOLD=2

# Etap 3: local accounts (адмін-маршрути автентифікуються сесією, не
# спільним ключем — перший обліковий запис створюється CLI
# `npm run create-admin --workspace=api -- --username X --password Y`).
SESSION_TTL_HOURS=24
# false лише для локальної розробки по http; в production лишайте
# незаданим (дефолт true — Secure-cookie).
COOKIE_SECURE=false
HEARTBEAT_EXPECTED_INTERVAL_MINUTES=60
