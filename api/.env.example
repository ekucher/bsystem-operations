# Скопіюйте як .env для локального запуску (не комітиться).

PORT=8080
DB_PATH=./data/operations.sqlite3

# Обидва нижче — БЕЗ дефолтів навмисно: без них enroll/admin-маршрути
# fail-closed (503), а не приймають запити без автентифікації.
OPERATIONS_BOOTSTRAP_SECRET=change-me
ADMIN_API_KEY=change-me

EVENT_RETENTION_DAYS=90
HEARTBEAT_MISSED_THRESHOLD=2
